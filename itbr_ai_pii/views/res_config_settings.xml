<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.itbr_ai_pii</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="base.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//form" position="inside">
				<app string="Personal data and AI" name="itbr_ai_pii" groups="base.group_system">
					<block title="Personal data and AI" name="itbr_ai_pii_settings">
						<setting
							id="itbr_ai_pii_enabled"
							help="Personal data sent to the AI provider is swapped for tokens."
						>
							<field name="itbr_ai_pii_enabled"/>
							<div
								class="text-warning mt-2"
								invisible="itbr_ai_pii_key_set"
							>
								No key set on the server (ODOO_AI_PII_KEY or ai_pii_key in the Odoo configuration file): personal data is not protected.
							</div>
							<field name="itbr_ai_pii_key_set" invisible="1"/>
						</setting>
						<setting
							id="itbr_ai_pii_blocked_models"
							string="Blocked models"
							help="Models the AI cannot read at all, comma-separated."
						>
							<field name="itbr_ai_pii_blocked_models"/>
						</setting>
						<setting
							id="itbr_ai_pii_email_domains"
							string="Company e-mail domains"
							help="E-mail addresses on these domains are kept as they are, comma-separated."
						>
							<field name="itbr_ai_pii_email_domains"/>
						</setting>
						<setting
							id="itbr_ai_pii_field_exposure"
							string="AI field exposure"
							help="See and adjust which fields are tokenized or blocked."
						>
							<div class="mt-2">
								<button
									name="%(itbr_ai_pii.action_ir_model_fields_ai_exposure)d"
									type="action"
									string="Open the field list"
									class="btn-link"
								/>
							</div>
						</setting>
					</block>
				</app>
			</xpath>
		</field>
	</record>

</odoo>
